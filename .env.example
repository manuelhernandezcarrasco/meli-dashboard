# Mercado Libre app credentials (never commit real values)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/auth/callback

# demo | live
DATA_SOURCE=demo

# Demo source only; live syncs start at zero from Mercado Libre
#BASE_PNL_PATH=data/PnL_MercadoLibre_Septiembre2026.xlsx
#VENTAS_DIRECTAS_PATH=data/Ventas_Directas_y_Mapeo.xlsx

# Postgres (docker compose)
POSTGRES_USER=pnl
POSTGRES_PASSWORD=pnl
POSTGRES_DB=pnl
DATABASE_URL=postgresql://pnl:pnl@localhost:5432/pnl

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: database used by the DB-backed tests (default: pnl_t6, see docs/database/README.md)
#TEST_DATABASE_URL=postgresql://pnl:pnl@localhost:5432/pnl_test

# Stock reconcile (S4): the cron job calls GET /api/cron/stock-reconcile with `Authorization: Bearer $CRON_SECRET`.
# Generate with `openssl rand -hex 32`. The route answers 401 when it is empty.
CRON_SECRET=
