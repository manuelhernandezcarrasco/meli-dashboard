generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mercado Libre OAuth tokens, one row per signed-in (Clerk) user.
model MlToken {
  ownerId      String   @id
  accessToken  String
  refreshToken String
  userId       BigInt
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

/// Per-user cache of API lookups: ship:<id>, gtin:<itemId>, tax:<paymentId>, orders:YYYY-MM
model ApiCache {
  ownerId   String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([ownerId, key])
}

/// Last computed DashboardData per user and month (YYYY-MM).
model Snapshot {
  ownerId    String
  month      String
  payload    Json
  computedAt DateTime

  @@id([ownerId, month])
}
