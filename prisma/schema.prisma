// Database reference: docs/database/README.md  (ERDs, table dictionary, conventions, changelog).
// Any change here MUST update docs/database/CHANGELOG.md; `pnpm db:docs` regenerates the ERD
// and a test fails when docs/database/erd.generated.md is stale.
//
// Conventions
//  - Tenant root is `Account` (Clerk user id). Every business row carries `accountId` as the first
//    column of its primary key, so one index serves "everything of this user" and composite
//    foreign keys make cross-tenant references impossible.
//  - Money from Mercado Libre / Mercado Pago and derived money is `Decimal(16,4)` (ARS).
//    Values read from the user's Excel (weighted costs, margins, ratios) are `Float`.
//  - Instants are `timestamptz`. Calendar days are `date`. Months are `"YYYY-MM"` (char(7)).
//  - Marketplace-assigned numeric ids (orders, payments, shipments, sellers) are `BigInt`, and always
//    keyed together with `marketplace`, because ids from different marketplaces can collide.
//  - JSON is only used for derived read models (Snapshot.payload, MarketScan.regression), never for
//    facts that statistics need to filter, join or aggregate.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Which Excel file an Upload came from.
enum UploadKind {
  pnl
  inputs
}

/// Identifier that an Excel "Mapeo" row translates to an EAN.
enum MappingKind {
  item
  sku
}

/// A person's answer to "is this listing that P&L product?".
enum MatchVerdict {
  confirmed
  rejected
}

/// External sales channels the app syncs from. A new marketplace is one more value here plus a
/// connector that writes the Marketplace-keyed tables.
enum Marketplace {
  mercadolibre
}

/// How a SaleLine was sold: through a marketplace (see SaleLine.marketplace) or directly ("venta directa").
enum Channel {
  marketplace
  direct
}

/// Why a market offer was left out of the scatter and the regressions.
enum OfferExclusion {
  price_outlier
  sales_outlier
  cap
}

/// Why an InventoryProduct's stock changed. The sign of StockMovement.quantity says the direction.
enum MovementType {
  /// Opening stock counted at cutover (or when a product is switched live).
  initial_count
  /// Goods received through a confirmed purchase invoice.
  purchase_in
  /// Units sold on a marketplace.
  sale
  /// A sale cancelled before shipping: units go back.
  sale_cancel
  /// A returned unit confirmed as sellable again.
  return_restock
  /// Moved from the repair bucket back to sellable stock.
  repair_in
  /// Moved from sellable stock into the repair bucket.
  repair_out
  /// Units written off (lost, broken, returned and not recoverable).
  loss
  /// Manual correction by the user.
  manual_adjust
  /// Stock set by an Excel upload after cutover (acts as a correction event).
  excel_reset
}

/// Whether ML pushes for a product are only logged or really sent.
enum SyncMode {
  dry_run
  live
}

/// Kinds of StockAlert.
enum AlertType {
  low_stock
  out_of_stock
  negative_stock
  push_failed
  stock_drift
  margin_drop
  unmatched_sale
  suggested_match
  auto_match
  missing_cost
  unmatched_listing
  link_cost_review
}

/// Lifecycle of a StockAlert.
enum AlertStatus {
  open
  acknowledged
  resolved
}

/// Lifecycle of a PurchaseInvoice. Nothing touches stock while it is a draft.
enum InvoiceStatus {
  draft
  applied
  voided
}

/// What was decided for a returned unit.
enum ReturnOutcome {
  pending
  lost
  in_repair
  restocked
}

/// Result of one stock push to a marketplace.
enum PushResult {
  dry_run
  ok
  failed
  skipped
}

/// How an invoice line was tied to a product.
enum LineResolution {
  auto_ean
  manual_match
  created_product
  unresolved
}

/// Why a ProductCostEntry was written.
enum CostReason {
  invoice
  excel
  initial
  manual
}

/// Per-listing push state.
enum SyncStatus {
  never
  in_sync
  drift
  failed
}

/// What caused a push.
enum PushTrigger {
  sale
  invoice
  adjust
  reconcile
  manual
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. Tenancy and connection
// ─────────────────────────────────────────────────────────────────────────────

/// A signed-in user (Clerk user id). Deleting an Account deletes everything it owns.
model Account {
  /// Clerk user id (`user_...`).
  id        String   @id
  /// First time the app saw this user (or the oldest legacy row, for migrated users).
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  connections    MarketplaceConnection[]
  uploads        Upload[]
  products       Product[]
  pnlClosing     PnlClosing?
  costOverrides  CostOverride[]
  mappings       ProductMapping[]
  directSales    DirectSale[]
  stockReceipts  StockReceipt[]
  matchDecisions MatchDecision[]
  listings       Listing[]
  shipments      Shipment[]
  orders         Order[]
  orderPeriods   OrderPeriod[]
  payments       Payment[]
  saleLines      SaleLine[]
  snapshots      Snapshot[]
  marketScans    MarketScan[]

  inventoryProducts InventoryProduct[]
  stockMovements    StockMovement[]
  costEntries       ProductCostEntry[]
  purchaseInvoices  PurchaseInvoice[]
  invoiceLines      PurchaseInvoiceLine[]
  listingLinks      ListingLink[]
  linkComponents    ListingLinkComponent[]
  syncStates        ListingSyncState[]
  pushLogs          MlPushLog[]
  stockAlerts       StockAlert[]
  returnCases       ReturnCase[]
  webhookEvents     WebhookEvent[]
  inventorySettings InventorySettings?
  competitorSales   CompetitorSale[]
}

/// The user's OAuth link to one marketplace (replaces MlToken). Refresh tokens are single use, so the
/// row is rewritten on every refresh. One row per account and marketplace.
model MarketplaceConnection {
  accountId      String
  marketplace    Marketplace
  /// The seller's id inside the marketplace (for Mercado Libre: the `seller` filter of every orders query).
  externalUserId String
  /// Short-lived bearer token (refreshed when it expires in < 5 min).
  accessToken    String
  /// Single-use token that mints the next pair.
  refreshToken   String
  /// When `accessToken` stops being valid.
  expiresAt      DateTime    @db.Timestamptz(3)
  /// When the user linked their account.
  linkedAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, marketplace])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Business master data (what the user uploads in Excel)
// ─────────────────────────────────────────────────────────────────────────────

/// Metadata of the last file uploaded per kind. The raw .xlsx is never kept; it is parsed into the
/// tables below inside one transaction.
model Upload {
  accountId  String
  /// `pnl` = closing P&L (products + previous totals); `inputs` = direct sales, mappings, overrides, restocking.
  kind       UploadKind
  /// Name of the file as uploaded (display only).
  fileName   String
  /// Products in a `pnl` file, direct-sale rows in an `inputs` file (shown in the UI).
  rowCount   Int
  uploadedAt DateTime   @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, kind])
}

/// A product of the user's P&L close ("base"): one row per EAN. Replaced as a whole by each "pnl"
/// upload. Costs are weighted averages (ratios), hence Float.
model Product {
  accountId     String
  /// EAN-13 of the product (the join key to listings through GTIN / mapping).
  ean           String
  /// Product name in the Excel ("Descripción").
  description   String
  /// Model column of the Excel.
  model         String
  /// SONY, PLAY STATION, XBOX, BOSCH, VINOS, ONFAN or OTRAS.
  category      String
  /// "CU Pond.": weighted average unit cost of the close.
  unitCost      Float
  /// Final stock of the close = initial stock of the month being tracked.
  stockFinal    Float
  /// "Mg asum.": margin assumed when no real cost exists (0..1).
  assumedMargin Float
  /// Marketplace cost as a fraction of sales in the previous close (null when unknown).
  prevMlCostPct Float?
  /// Units sold in the previous close (consumption-rate fallback).
  prevUnits     Float
  /// Row order in the uploaded file; ties in the stock ranking fall back to it.
  position      Int

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, ean])
  @@index([accountId, category])
}

/// Totals of the previous close, used to calibrate the tax estimate and as the comparison base.
model PnlClosing {
  accountId   String @id
  /// Sales through Mercado Libre in the previous close.
  salesMl     Float
  /// Direct sales in the previous close.
  salesDirect Float
  /// Total sales.
  sales       Float
  /// Marketplace costs (fees + shipping + taxes) charged by Mercado Libre.
  mlCosts     Float
  /// Cost of goods sold.
  cogs        Float
  /// Units sold.
  units       Float
  /// Net income after marketplace costs.
  netIncome   Float
  /// Gross margin of the close.
  margin      Float

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// "Override" sheet: a person-set unit cost for an EAN that wins over the close.
model CostOverride {
  accountId   String
  /// Product the override applies to (may not be in `Product`).
  ean         String
  /// Unit cost to use instead of the close's weighted cost.
  unitCost    Float
  /// Description to show when the product is not in the close.
  description String
  /// Category to use; null = keep the product's.
  category    String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, ean])
}

/// "Mapeo ML" / "Mapeo SKU" sheets: listing id or seller SKU -> EAN. Replaced by each "inputs" upload.
model ProductMapping {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  /// `item` = Mercado Libre listing id, `sku` = seller SKU.
  kind        MappingKind
  /// The listing id or SKU being mapped.
  key         String
  /// EAN it maps to.
  ean         String

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, marketplace, kind, key])
  @@index([accountId, marketplace, ean])
}

/// "Ventas directas" sheet: sales made outside Mercado Libre.
model DirectSale {
  id          BigInt   @id @default(autoincrement())
  accountId   String
  /// Day of the sale.
  saleDate    DateTime @db.Date
  /// Customer name as written in the sheet.
  customer    String
  /// Product sold.
  ean         String
  /// Description as written in the sheet.
  description String
  /// Units.
  quantity    Decimal  @db.Decimal(14, 3)
  /// Price per unit (ARS).
  unitPrice   Decimal  @db.Decimal(16, 4)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, saleDate])
  @@index([accountId, ean])
}

/// "Ingresos" sheet: stock received (restocking) per EAN and day.
model StockReceipt {
  id          BigInt   @id @default(autoincrement())
  accountId   String
  /// Day the stock arrived.
  receiptDate DateTime @db.Date
  /// Product restocked.
  ean         String
  /// Units received.
  quantity    Decimal  @db.Decimal(14, 3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, receiptDate])
  @@index([accountId, ean])
}

/// A person's yes/no on a title-similarity suggestion. Survives Excel re-uploads (unlike the
/// mapping sheet). `itemId` and `ean` are soft references on purpose: both come from outside
/// (Mercado Libre, Excel) and can disappear between uploads without invalidating the decision.
model MatchDecision {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  /// Listing id (upper case).
  itemId      String
  /// EAN the person answered about.
  ean         String
  /// `confirmed`: use this EAN for the listing. `rejected`: never suggest or auto-match it again.
  decision    MatchVerdict
  /// When the person answered.
  decidedAt   DateTime     @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, marketplace, itemId, ean])
  @@index([accountId, marketplace, itemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Marketplace facts (what a marketplace API returns, normalized; `marketplace` is part of every key)
// ─────────────────────────────────────────────────────────────────────────────

/// One of the user's listings ("publicación"). Holds what used to live in the `gtin:` and
/// `catalog:` ApiCache keys, plus the link to the P&L product found by the matcher.
model Listing {
  accountId        String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace      Marketplace
  /// Mercado Libre listing id (`MLA...`), upper case.
  itemId           String
  /// Current listing title (null for listings only known through a search).
  title            String?
  /// ML `catalog_product_id`; null with `catalogCheckedAt` set = "asked, listing has none".
  catalogProductId String?
  catalogCheckedAt DateTime?   @db.Timestamptz(3)
  /// Item-level GTIN; null with `gtinCheckedAt` set = "asked, no GTIN".
  gtin             String?
  gtinCheckedAt    DateTime?   @db.Timestamptz(3)
  /// EAN of the P&L product this listing was matched to (soft reference to Product.ean).
  matchedEan       String?
  /// Lower-cased, accent-free "title + P&L description" for the own-product search.
  searchText       String      @default("")
  firstSeenAt      DateTime    @default(now()) @db.Timestamptz(3)
  /// Last time a column other than `firstSeenAt` changed (no-op syncs do not touch it).
  updatedAt        DateTime    @default(now()) @db.Timestamptz(3)

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  variations ListingVariation[]
  orderItems OrderItem[]

  @@id([accountId, marketplace, itemId])
  @@index([accountId, marketplace, catalogProductId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// GTIN of one variation of a listing.
model ListingVariation {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  itemId      String
  /// Mercado Libre variation id.
  variationId BigInt
  /// GTIN/EAN/UPC of the variation.
  gtin        String

  listing Listing @relation(fields: [accountId, marketplace, itemId], references: [accountId, marketplace, itemId], onDelete: Cascade)

  @@id([accountId, marketplace, itemId, variationId])
}

/// Public seller nicknames per marketplace. Global (not per tenant): a nickname is public data.
model Seller {
  /// Mercado Libre seller id.
  marketplace Marketplace
  sellerId    BigInt
  /// Public nickname.
  nickname    String
  /// When the nickname was read.
  fetchedAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@id([marketplace, sellerId])
}

/// Shipment cost charged to (positive) or credited to (negative) the seller. A row exists as soon
/// as an order references the shipment; `costFetchedAt` null = cost not asked yet.
model Shipment {
  accountId     String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace   Marketplace
  /// Mercado Libre shipment id.
  shippingId    BigInt
  /// Net cost for the seller: positive = charged, negative = credited (Flex bonus).
  sellerCost    Decimal?    @db.Decimal(16, 4)
  /// When `sellerCost` was read from the API; null = not asked yet. Shipments of orders < 3 days old are asked again.
  costFetchedAt DateTime?   @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@id([accountId, marketplace, shippingId])
}

/// A marketplace order, current month included. It belongs to the month of its own `createdAt` (Argentine
/// calendar), whichever download delivered it. Read back ordered by (createdAt, orderId).
model Order {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  /// Mercado Libre order id.
  orderId     BigInt
  /// Pack the order belongs to (several orders paid together); null if none.
  packId      BigInt?
  /// `paid`, `cancelled`, ... Only `paid` orders count as sales.
  status      String
  /// Creation instant (Argentina is UTC-3, no DST).
  createdAt   DateTime    @db.Timestamptz(3)
  /// Shipment of the order; null for pick-up / digital.
  shippingId  BigInt?
  /// When this row was last rewritten (a sync only rewrites rows that actually changed).
  updatedAt   DateTime    @default(now()) @db.Timestamptz(3)

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shipment Shipment?      @relation(fields: [accountId, marketplace, shippingId], references: [accountId, marketplace, shippingId], onDelete: NoAction)
  items    OrderItem[]
  payments OrderPayment[]

  @@id([accountId, marketplace, orderId])
  @@index([accountId, createdAt])
  @@index([accountId, marketplace, shippingId])
}

/// A line of an order. `lineNo` is the position inside the order (ML gives no line id).
model OrderItem {
  accountId         String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace       Marketplace
  orderId           BigInt
  /// 0-based position inside the order.
  lineNo            Int
  /// Listing sold (upper case).
  itemId            String
  /// Title at the time of the sale (the listing title can change later).
  title             String
  /// SKU the seller set on the listing, if any.
  sellerSku         String?
  /// Alternative SKU field, if any.
  sellerCustomField String?
  /// Variation sold, if the listing has variations.
  variationId       BigInt?
  /// Units sold.
  quantity          Int
  /// Price per unit (ARS).
  unitPrice         Decimal     @db.Decimal(16, 4)
  /// Marketplace fee per unit (includes the financing fee, see Payment.financingFee).
  saleFee           Decimal     @db.Decimal(16, 4)

  order   Order        @relation(fields: [accountId, marketplace, orderId], references: [accountId, marketplace, orderId], onDelete: Cascade)
  listing Listing      @relation(fields: [accountId, marketplace, itemId], references: [accountId, marketplace, itemId], onDelete: NoAction)
  returns ReturnCase[]

  @@id([accountId, marketplace, orderId, lineNo])
  @@index([accountId, marketplace, itemId])
}

/// A Mercado Pago payment and the taxes billed on it. A payment can be shared by several orders of
/// a pack, hence the OrderPayment link table.
/// `taxFetchedAt` null = never asked; set with `taxTotal` null = "asked, no detail available".
model Payment {
  accountId    String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace  Marketplace
  /// Mercado Pago payment id.
  paymentId    BigInt
  /// Sum of the taxes billed to the seller on this payment.
  taxTotal     Decimal?    @db.Decimal(16, 4)
  /// "Costo por ofrecer cuotas"; part of the order items' saleFee.
  financingFee Decimal?    @db.Decimal(16, 4)
  taxFetchedAt DateTime?   @db.Timestamptz(3)

  account Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  taxes   PaymentTax[]
  orders  OrderPayment[]

  @@id([accountId, marketplace, paymentId])
}

/// One tax charge of a payment (IVA, IIBB, SIRCREB...).
model PaymentTax {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  paymentId   BigInt
  /// Tax name as Mercado Pago reports it (e.g. `IIBB Retención CABA`).
  name        String
  /// Tax amount net of refunds (ARS).
  amount      Decimal     @db.Decimal(16, 4)

  payment Payment @relation(fields: [accountId, marketplace, paymentId], references: [accountId, marketplace, paymentId], onDelete: Cascade)

  @@id([accountId, marketplace, paymentId, name])
}

/// Which payments settle which order, with the payment status as the order reports it.
model OrderPayment {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  orderId     BigInt
  paymentId   BigInt
  /// Payment status inside the order (`approved`, ...). Only approved payments count.
  status      String

  order   Order   @relation(fields: [accountId, marketplace, orderId], references: [accountId, marketplace, orderId], onDelete: Cascade)
  payment Payment @relation(fields: [accountId, marketplace, paymentId], references: [accountId, marketplace, paymentId], onDelete: NoAction)

  @@id([accountId, marketplace, orderId, paymentId])
  @@index([accountId, marketplace, paymentId])
}

/// Sync state of one month of orders: a closed month marked `isFinal` is read from Order/OrderItem
/// and never downloaded again.
model OrderPeriod {
  accountId   String
  /// Marketplace the ids of this row belong to (ids from different marketplaces can collide).
  marketplace Marketplace
  /// `YYYY-MM`, Argentine calendar.
  month       String      @db.Char(7)
  /// Closed month already re-downloaded after day 5 of the next month: never fetched again.
  isFinal     Boolean
  /// Orders downloaded for the month.
  orderCount  Int
  /// When the month was last downloaded.
  fetchedAt   DateTime    @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, marketplace, month])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Derived read models (always rebuildable from sections 2 and 3)
// ─────────────────────────────────────────────────────────────────────────────

/// One economics line (what `buildLines` computes): a sold order line or a direct sale, with the
/// full marketplace cost breakdown. Rebuilt for a whole month on every sync. This is the table the
/// statistics queries should hit: margin = revenue - marketplaceCost - cogs.
model SaleLine {
  accountId       String
  /// `YYYY-MM` of the sale (same as `saleDate`).
  period          String       @db.Char(7)
  /// Position in the month's sorted lines (date, time, channel).
  lineNo          Int
  /// Day of the sale, Argentina time.
  saleDate        DateTime     @db.Date
  /// "HH:MM" Argentina time; empty for direct sales.
  saleTime        String       @db.VarChar(5)
  /// `marketplace` or `direct` (venta directa).
  /// Marketplace the line was sold on; null for direct sales.
  marketplace     Marketplace?
  channel         Channel
  /// Pack/order id for marketplace lines, customer for direct sales.
  orderRef        String
  itemId          String?
  sku             String?
  /// P&L product the line was matched to; null = unmatched.
  ean             String?
  /// How the EAN was found: "Mapeo item", "GTIN publicación", "Similitud de título", ...
  matchVia        String
  matchScore      Float?
  suggestedEan    String?
  /// Product description (Excel name when matched, listing title otherwise).
  description     String
  listingTitle    String?
  /// Product category, or `SIN MATCH` when unmatched.
  category        String
  /// Units.
  quantity        Decimal      @db.Decimal(14, 3)
  /// Price per unit.
  unitPrice       Decimal      @db.Decimal(16, 4)
  /// quantity × unitPrice.
  revenue         Decimal      @db.Decimal(16, 4)
  /// Selling fee, without the financing part.
  saleFee         Decimal      @db.Decimal(16, 4)
  /// Installment-offering fee.
  financingFee    Decimal      @db.Decimal(16, 4)
  /// Share of the shipment cost allocated to this line.
  shippingCost    Decimal      @db.Decimal(16, 4)
  /// Taxes: real (Mercado Pago) or estimated, see `taxSource`.
  taxAmount       Decimal      @db.Decimal(16, 4)
  /// saleFee + financingFee + shippingCost + taxAmount.
  marketplaceCost Decimal      @db.Decimal(16, 4)
  /// Cost per unit used (close, override, or assumed margin), see `costSource`.
  unitCost        Float
  /// quantity * unitCost.
  cogs            Decimal      @db.Decimal(16, 4)
  /// `Real (CU Pond. cierre)`, `Override`, `Asumido xx%`, `Sin match – asumido xx%`.
  costSource      String
  /// `Mercado Pago` (real) or `Estimado x%`.
  taxSource       String
  /// Per-tax breakdown as text (`name amount; ...`).
  taxDetail       String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, period, lineNo])
  @@index([accountId, saleDate])
  @@index([accountId, ean, saleDate])
  @@index([accountId, itemId])
}

/// The computed dashboard (`DashboardData`) of a month, served as is to the UI.
model Snapshot {
  accountId  String
  /// `YYYY-MM` the dashboard is about.
  month      String   @db.Char(7)
  /// `DashboardData` (src/lib/contracts.ts), validated with Zod on read and write.
  payload    Json
  /// When it was computed; decides when a background refresh is due.
  computedAt DateTime @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, month])
  @@index([accountId, computedAt(sort: Desc)])
}

/// One pull of the public offers of a catalog product ("market research"). Kept as history so
/// price evolution can be charted; older scans are pruned by `pruneMarketScans`.
model MarketScan {
  id               BigInt      @id @default(autoincrement())
  accountId        String
  marketplace      Marketplace
  /// Mercado Libre catalog product the offers belong to.
  catalogProductId String
  /// Catalog product name.
  catalogTitle     String
  /// When the offers were pulled.
  fetchedAt        DateTime    @db.Timestamptz(3)
  /// `{ log, linear }` regressions (null when n < 3); tiny, never filtered on.
  regression       Json

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  offers  MarketOffer[]

  @@index([accountId, marketplace, catalogProductId, fetchedAt(sort: Desc)])
}

/// One seller's offer in a MarketScan. `title` and `permalink` are null when they equal the
/// catalog title / the canonical permalink of the item.
model MarketOffer {
  /// Scan the offer belongs to.
  scanId       BigInt
  /// Order inside the scan (kept points first, then excluded ones).
  position     Int
  /// Offer's listing id.
  itemId       String
  /// Offer's seller (soft reference to `Seller`; nicknames are only known for some).
  sellerId     BigInt
  title        String?
  /// Listed price (ARS).
  price        Decimal         @db.Decimal(16, 4)
  /// Units sold; null when Mercado Libre does not disclose it for other sellers.
  soldQuantity Int?
  /// false = lower bound of Mercado Libre's sales bucket.
  soldExact    Boolean
  /// The offer belongs to the account's own seller.
  isOurs       Boolean
  permalink    String?
  /// Why the offer is left out of the regressions; null = included.
  excluded     OfferExclusion?

  scan MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@id([scanId, position])
  @@index([itemId])
  @@index([sellerId])
}

/// Units another seller's listing has sold, read by the user's browser collector from the public
/// listing page (the API does not disclose it). Latest reading per listing; feeds the market regressions.
model CompetitorSale {
  accountId   String
  marketplace Marketplace
  /// Competitor's listing id (upper case).
  itemId      String
  /// Units sold as shown on the listing page.
  sold        Int
  /// Seller nickname shown on the page, if any.
  nickname    String?
  /// When the collector sent the reading.
  collectedAt DateTime    @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, marketplace, itemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Inventory (stock ledger, cost, purchases, listing links, ML push, alerts, returns)
//    Surrogate ids: `id BigInt @default(autoincrement())` inside a tenant-first primary key
//    `(accountId, id)`, so composite foreign keys `(accountId, …Id)` still work.
//    Design: docs/tickets/stock/PLAN.md
// ─────────────────────────────────────────────────────────────────────────────

/// A product we hold in stock: the permanent master of what we buy and sell (unlike `Product`, the
/// P&L close snapshot replaced by each upload). `onHand`, `inRepair` and `unitCost` are caches derived
/// from StockMovement / ProductCostEntry and are only changed by `appendMovement`. Archive, never delete.
model InventoryProduct {
  id         BigInt    @default(autoincrement())
  accountId  String
  /// GTIN-13. Unique per account when set; products without one are matched by hand.
  ean        String?
  sku        String?
  name       String
  model      String    @default("")
  category   String    @default("")
  /// Optional minimum units that overrides the day-based low-stock thresholds.
  minUnits   Decimal?  @db.Decimal(14, 3)
  /// Sellable units. Can go negative (raises an alert); marketplaces only ever receive max(0, onHand).
  onHand     Decimal   @default(0) @db.Decimal(14, 3)
  /// Units in the repair bucket (not sellable).
  inRepair   Decimal   @default(0) @db.Decimal(14, 3)
  /// Current moving weighted-average cost per unit, gross (taxes not netted out), ARS.
  unitCost   Decimal   @default(0) @db.Decimal(16, 4)
  /// `dry_run` = pushes to the marketplace are logged only; `live` = really sent.
  syncMode   SyncMode  @default(dry_run)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  account    Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  movements  StockMovement[]
  costs      ProductCostEntry[]
  lines      PurchaseInvoiceLine[]
  components ListingLinkComponent[]
  alerts     StockAlert[]
  returns    ReturnCase[]

  @@id([accountId, id])
  @@unique([accountId, ean])
  @@index([accountId, category])
}

/// Append-only stock ledger. One row per stock event; never updated or deleted. `onHand` of the
/// product is the running sum. Idempotent through `idempotencyKey`.
model StockMovement {
  id             BigInt       @default(autoincrement())
  accountId      String
  productId      BigInt
  type           MovementType
  /// Signed units: positive = in, negative = out.
  quantity       Decimal      @db.Decimal(14, 3)
  /// When it happened in the real world (sale date, invoice date, ...).
  occurredAt     DateTime     @db.Timestamptz(3)
  /// When we wrote the row.
  recordedAt     DateTime     @default(now()) @db.Timestamptz(3)
  /// Product `onHand` right after this movement.
  onHandAfter    Decimal      @db.Decimal(14, 3)
  /// Weighted-average cost right after this movement.
  unitCostAfter  Decimal      @db.Decimal(16, 4)
  /// Caller-chosen key that makes the write safe to repeat, e.g. `sale:MLA:123:0`, `invoice:42:3`.
  idempotencyKey String
  /// Kind of the thing that caused it: `order`, `invoice`, `return`, `excel`, `cutover`, ...
  refType        String?
  /// Id of that thing (an order line is `<orderId>:<lineNo>`).
  refId          String?
  reason         String?
  /// Who caused it: `system`, `user` or `webhook`.
  actor          String

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)

  @@id([accountId, id])
  @@unique([accountId, idempotencyKey])
  @@index([accountId, productId, occurredAt(sort: Desc)])
  @@index([accountId, refType, refId])
}

/// Cost history of a product, used to freeze the cost of a sale at the moment it happened:
/// the cost of a sale is the latest entry with `effectiveFrom <= sale time`.
model ProductCostEntry {
  id             BigInt     @default(autoincrement())
  accountId      String
  productId      BigInt
  effectiveFrom  DateTime   @db.Timestamptz(3)
  /// Weighted-average cost from `effectiveFrom` on, ARS, gross.
  unitCost       Decimal    @db.Decimal(16, 4)
  /// Stock on hand when the cost changed (the weight of the old cost).
  onHandAtChange Decimal    @db.Decimal(14, 3)
  reason         CostReason
  refType        String?
  refId          String?
  note           String?

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)

  @@id([accountId, id])
  @@index([accountId, productId, effectiveFrom(sort: Desc)])
}

/// A supplier invoice. Parsed into `draft`, reviewed by the user, and only `applied` writes stock and cost.
/// `feeFactor = total / subtotal` spreads taxes and perceptions over every line (gross landed cost).
model PurchaseInvoice {
  id                  BigInt        @default(autoincrement())
  accountId           String
  supplierName        String
  /// Supplier CUIT. Part of the duplicate-invoice guard.
  supplierTaxId       String
  /// Invoice number as printed, e.g. `0225-00085935`.
  number              String
  issueDate           DateTime      @db.Date
  currency            String        @default("ARS")
  subtotal            Decimal       @db.Decimal(16, 4)
  ivaAmount           Decimal       @default(0) @db.Decimal(16, 4)
  perceptionsAmount   Decimal       @default(0) @db.Decimal(16, 4)
  otherTaxesAmount    Decimal       @default(0) @db.Decimal(16, 4)
  total               Decimal       @db.Decimal(16, 4)
  /// Multiplier applied to every line's net price to get its landed unit cost.
  feeFactor           Decimal       @db.Decimal(12, 8)
  /// True when the user edited `feeFactor` in the review screen.
  feeFactorOverridden Boolean       @default(false)
  status              InvoiceStatus @default(draft)
  appliedAt           DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  /// Uploaded PDF file name (display only; the file itself is not kept).
  sourceFileName      String

  account Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines   PurchaseInvoiceLine[]

  @@id([accountId, id])
  @@unique([accountId, supplierTaxId, number])
}

/// One line of a PurchaseInvoice, with the product it was resolved to (once resolved).
model PurchaseInvoiceLine {
  accountId      String
  invoiceId      BigInt
  /// 1-based position on the invoice.
  lineNo         Int
  /// Supplier's own code for the item.
  supplierCode   String         @default("")
  /// Normalized GTIN-13 read from the line, if any.
  ean            String?
  description    String
  quantity       Decimal        @db.Decimal(14, 3)
  unitPrice      Decimal        @db.Decimal(16, 4)
  discount       Decimal        @default(0) @db.Decimal(16, 4)
  lineSubtotal   Decimal        @db.Decimal(16, 4)
  /// `unitPrice` after discount times the invoice's `feeFactor`.
  landedUnitCost Decimal        @db.Decimal(16, 4)
  productId      BigInt?
  resolution     LineResolution @default(unresolved)

  invoice PurchaseInvoice   @relation(fields: [accountId, invoiceId], references: [accountId, id], onDelete: Cascade)
  product InventoryProduct? @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)
  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, invoiceId, lineNo])
  @@index([accountId, productId])
}

/// Ties a marketplace listing (or one of its variations) to what we stock. The unique index on
/// `(accountId, marketplace, itemId, COALESCE(variationId, 0))` lives only in the migration (NULL counts
/// as one value). `itemId` is a soft reference to `Listing` (a link may exist before the listing is synced).
model ListingLink {
  id          BigInt      @default(autoincrement())
  accountId   String
  marketplace Marketplace
  /// Listing id, upper case.
  itemId      String
  /// Null = the whole listing; set = that variation.
  variationId BigInt?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  account    Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  components ListingLinkComponent[]
  syncState  ListingSyncState?

  @@id([accountId, id])
  @@index([accountId, marketplace, itemId])
}

/// A (product, quantity) a link is made of. A simple listing has one component with quantity 1; a combo has several.
/// Available quantity of the link = min over components of floor(onHand / quantity).
model ListingLinkComponent {
  accountId String
  linkId    BigInt
  productId BigInt
  /// Units of the product consumed by one unit of the listing.
  quantity  Decimal @default(1) @db.Decimal(14, 3)

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  link    ListingLink      @relation(fields: [accountId, linkId], references: [accountId, id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)

  @@id([accountId, linkId, productId])
  @@index([accountId, productId])
}

/// What we last saw and last pushed for one link.
model ListingSyncState {
  accountId         String
  linkId            BigInt
  /// `available_quantity` last read from the marketplace.
  lastObservedMlQty Int?
  lastObservedAt    DateTime?  @db.Timestamptz(3)
  lastPushedQty     Int?
  lastPushedAt      DateTime?  @db.Timestamptz(3)
  status            SyncStatus @default(never)
  lastError         String?

  account Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  link    ListingLink @relation(fields: [accountId, linkId], references: [accountId, id], onDelete: Cascade)

  @@id([accountId, linkId])
}

/// Append-only log of every stock push attempt (also the dry-run ones).
model MlPushLog {
  id            BigInt      @default(autoincrement())
  accountId     String
  marketplace   Marketplace
  itemId        String
  variationId   BigInt?
  /// Quantity we asked the marketplace to set.
  requestedQty  Int
  /// Quantity the marketplace had before, when known.
  previousMlQty Int?
  mode          SyncMode
  result        PushResult
  httpStatus    Int?
  error         String?
  triggerType   PushTrigger
  /// What triggered it (order id, invoice id, ...).
  triggerRef    String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, id])
  @@index([accountId, marketplace, itemId, createdAt(sort: Desc)])
}

/// Something the user must look at. `dedupeKey` is unique per account while the alert is not resolved
/// (partial unique index in the migration), so raising the same alert twice updates one row.
model StockAlert {
  id             BigInt       @default(autoincrement())
  accountId      String
  type           AlertType
  status         AlertStatus  @default(open)
  productId      BigInt?
  marketplace    Marketplace?
  itemId         String?
  /// Identity of the situation, e.g. `low_stock:<productId>`.
  dedupeKey      String
  title          String
  detail         String       @default("")
  /// Numeric context (units, days of coverage, ...).
  quantity       Decimal?     @db.Decimal(14, 3)
  /// Numeric context in ARS (cost, margin, ...).
  amount         Decimal?     @db.Decimal(16, 4)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  acknowledgedAt DateTime?    @db.Timestamptz(3)
  resolvedAt     DateTime?    @db.Timestamptz(3)
  /// How it was resolved: `auto` (condition cleared) or free text from the user.
  resolution     String?

  account Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product InventoryProduct? @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)

  @@id([accountId, id])
  @@index([accountId, status, type])
}

/// A returned unit waiting for a decision (never restocked automatically).
model ReturnCase {
  id          BigInt        @default(autoincrement())
  accountId   String
  marketplace Marketplace
  orderId     BigInt
  /// Position of the order line (same as OrderItem.lineNo).
  lineNo      Int
  productId   BigInt
  quantity    Decimal       @db.Decimal(14, 3)
  outcome     ReturnOutcome @default(pending)
  reason      String?
  openedAt    DateTime      @default(now()) @db.Timestamptz(3)
  resolvedAt  DateTime?     @db.Timestamptz(3)
  note        String?

  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product   InventoryProduct @relation(fields: [accountId, productId], references: [accountId, id], onDelete: NoAction)
  orderItem OrderItem        @relation(fields: [accountId, marketplace, orderId, lineNo], references: [accountId, marketplace, orderId, lineNo], onDelete: NoAction)

  @@id([accountId, id])
  @@unique([accountId, marketplace, orderId, lineNo])
}

/// Inbox of marketplace notifications (webhooks). The tenant is not known until the notification is
/// resolved, so `accountId` is nullable and the key is a plain surrogate id (the one exception to
/// tenant-first keys). Exact duplicates are dropped through `externalEventId` or, without it, the topic/resource/receivedAt key.
model WebhookEvent {
  id              BigInt      @id @default(autoincrement())
  accountId       String?
  marketplace     Marketplace
  /// Notification topic, e.g. `orders_v2`.
  topic           String
  /// Resource path the notification points to, e.g. `/orders/123`.
  resource        String
  /// Id the marketplace gave the notification, when it gives one.
  externalEventId String?
  receivedAt      DateTime    @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?   @db.Timestamptz(3)
  error           String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([marketplace, externalEventId])
  @@unique([marketplace, topic, resource, receivedAt])
  @@index([processedAt])
}

/// Per-account inventory configuration.
model InventorySettings {
  accountId       String
  /// Moment the ledger took over from the Excel; null = cutover not done yet.
  cutoverAt       DateTime? @db.Timestamptz(3)
  /// Sync mode given to new products.
  defaultSyncMode SyncMode  @default(dry_run)
  lastReconcileAt DateTime? @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId])
}
