generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mercado Libre OAuth tokens, one row per signed-in (Clerk) user.
model MlToken {
  ownerId      String   @id
  accessToken  String
  refreshToken String
  userId       BigInt
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

/// Per-user cache of API lookups: ship:<id>, gtin:<itemId>, tax:<paymentId>, orders:YYYY-MM
model ApiCache {
  ownerId   String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([ownerId, key])
}

/// Last computed DashboardData per user and month (YYYY-MM).
model Snapshot {
  ownerId    String
  month      String
  payload    Json
  computedAt DateTime

  @@id([ownerId, month])
}

/// Parsed contents of the Excel files a user uploaded. kind = "pnl" (closing P&L -> Base + prev
/// totals) or "inputs" (direct sales / mapping / cost overrides / stock intake). The raw .xlsx is
/// not kept: it is parsed on upload and only the normalized result is stored.
model UserWorkbook {
  ownerId    String
  kind       String
  fileName   String
  payload    Json
  uploadedAt DateTime @default(now())

  @@id([ownerId, kind])
}

/// A person's answer to "is this ML listing that P&L product?". decision = "confirmed" (use that
/// EAN for the listing, like a "Mapeo ML" row) or "rejected" (never suggest/auto-match that EAN
/// for the listing again). Survives Excel re-uploads, unlike the mapping sheet.
model MatchDecision {
  ownerId   String
  itemId    String
  ean       String
  decision  String
  decidedAt DateTime @default(now())

  @@id([ownerId, itemId, ean])
}
